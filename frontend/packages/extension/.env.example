# Copy to .env.local (git-ignored). All variables are read at build time by Vite.

# Backend URL (default http://localhost:8787)
# VITE_SQ_API_URL=http://localhost:8787

# fake = demo world without a backend, real = talk to the backend (default real)
# VITE_BRIDGE=real

# dev = simulated passkey from the backend's /dev keyring; default is real WebAuthn
# VITE_PASSKEY=dev

# Gasless USDC on Base Sepolia (ERC-4337 smart account + Pimlico paymaster). Free key at
# https://dashboard.pimlico.io: create an API key, then add a sponsorship policy for Base Sepolia
# (chain id 84532). Without it the "USDC sans gas" wallet is hidden and sends report TESTNET_GASLESS_OFF.
# VITE_PIMLICO_API_KEY=pim_...
